# ============================================================
# VoiceBot —— 发 Git 前的忽略规则
# ============================================================

# ---- 敏感信息(必须忽略,否则 key 会泄露) ----
config.py
config.py.bak
*.key
*.secret
.env
.env.*

# ---- 大体积目录(不要进仓库) ----
# vendor_py 是 pip 安装的依赖(312MB),应当用 pip 重新安装
#   pip install wechatauto-replica pywechat127 sounddevice pypinyin winsdk ...
vendor_py/
__pycache__/
*.pyc
*.pyo

# libs/ 里是 wxautox4_wechatbot 等**商业授权**安装包(42MB),
# 分发可能违反其许可,务必忽略!
libs/
*.whl
*.tar.gz

# 音频与截图(诊断产物,可重新生成)
04_音频留存/*.wav
04_音频留存/项目诊断音频/
05_文档/发送截图/
05_文档/运行日志/
05_文档/旧版备份/
05_文档/配置备份/
*.wav
*.png
*.jpg
*.jpeg

# 运行时状态
voice_bot_state.json
*.log

# 本地个人配置(含真实微信号/昵称,不进仓库)
voice_bot_config.local.py
*.local.py

# 参考音频配置(因人而异,用 02_工具面板/set_reference.py 各自生成)
reference_config.json
# 参考音频本身(体积大,且属个人素材)
参考音频/

# ---- 模型权重(极大,单独管理) ----
*.ckpt
*.pth

# ---- 系统 ----
Thumbs.db
desktop.ini
.DS_Store

# voice_bot.py 含个人 CHATS 配置(真实微信号),不进仓库。
# 发布版用 voice_bot.example.py 作为模板。
01_核心模块/voice_bot.py

# 按钮坐标(每台机器/每个窗口尺寸可能不同)
01_核心模块/voice_button_coords.json

# 「发布前隐私审计」用的本地词表 —— 里面会写真实昵称/微信号,绝不能进仓库
02_工具面板/.private_tokens.txt

# 对话记忆(含聊天内容,绝不进仓库)
voice_bot_memory.json
